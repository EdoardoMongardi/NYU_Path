# NYU Path — environment template.
# Copy to `.env.local` at the repo root (apps/web reads a copy of it); fill only
# what you need. The test suite runs without any of these (live-DB / live-LLM
# suites self-skip). Keys are read in packages/engine/src/agent/clients/index.ts
# and apps/web. NEVER commit a filled-in .env.local — it is gitignored.

# ── LLM providers ──────────────────────────────────────────────────────────
# Primary is Anthropic claude-sonnet-4-6; fallback is OpenAI gpt-4.1-mini.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # fallback model + embeddings
COHERE_API_KEY=           # RAG reranker

# Model overrides (optional — defaults are in clients/index.ts)
NYUPATH_PRIMARY_MODEL=            # e.g. claude-sonnet-4-6
NYUPATH_PRIMARY_PROVIDER=         # e.g. anthropic | openai
NYUPATH_FALLBACK_LOG_PATH=        # file to log fallback events to (optional)
NYUPATH_DISABLE_THINKING=         # set to 1 to disable extended thinking

# ── Web app (apps/web) ─────────────────────────────────────────────────────
DATABASE_URL=             # Postgres/Neon; omit to run on the in-memory store
SECRET_KEY=               # session / token signing (required for real logins)
RESEND_API_KEY=           # OTP login email (required for real logins)
AUTH_TEST_EMAILS=         # comma-separated emails allowed to bypass real email in dev

# Session store + feature flags (optional)
NYUPATH_SESSION_STORE_PATH=
PLAN_CHANGE_LLM_POLISH=                 # 1 to enable server-side plan-change polish
NEXT_PUBLIC_PLAN_CHANGE_LLM_POLISH=     # client mirror of the above
NEXT_PUBLIC_ENABLE_TEST_CLEAR=          # 1 to expose the dev "clear session" control

# ── Observability (optional basic-auth for the dashboard) ──────────────────
OBSERVABILITY_USER=
OBSERVABILITY_PASS=
