packages/engine/src/data/course_embeddings.json
data/

# Local-only documentation (project-internal notes; not source-of-truth in repo).
# Phase plan files at repo root (PHASE_*_PLAN.md) remain tracked normally.
/Project Documentations/docs/

# PII-containing source DPR PDFs and unredacted text extracts.
# Only the .redacted.txt + .expected.json fixtures may be committed.
SAA_STD_DS.pdf
SAA_STD_DS_WHATIF.pdf
packages/engine/tests/fixtures/dpr_sample.txt
packages/engine/tests/fixtures/*.unredacted.*

# Superpowers brainstorming visual-companion mockups (local only).
.superpowers/

# Scraper progress state (tool-local checkpointing)
tools/playwright-scraper/.scrape_progress.json

# Phase 7-E W8 — surrogate run results carry full transcripts that
# may include synthetic-but-PII-sensitive content; keep them local-only.
tools/cohort-eval/results/

# Stale tsc-emit artifacts that compete with .tsx sources under
# Next.js (Phase 7-E W12 incident — duplicate-page warnings + auth
# layout bypass when app/chat/page.js shadowed app/chat/page.tsx).
# tsconfig.json sets noEmit:true; this gitignore rule belt-and-suspenders.
apps/web/app/**/*.js
apps/web/app/**/*.js.map
apps/web/app/**/*.d.ts
apps/web/app/**/*.d.ts.map
apps/web/lib/**/*.js
apps/web/lib/**/*.js.map
apps/web/lib/**/*.d.ts
apps/web/lib/**/*.d.ts.map
packages/engine/src/**/*.js
packages/engine/src/**/*.js.map
packages/engine/src/**/*.d.ts
packages/engine/src/**/*.d.ts.map
# Same stale tsc-emit artifacts in the rest of the TS-source tree
# (noEmit:true means none of these should ever be tracked).
packages/engine/tests/**/*.js
packages/engine/tests/**/*.js.map
packages/engine/tests/**/*.d.ts
packages/engine/tests/**/*.d.ts.map
packages/engine/scripts/**/*.js
packages/engine/scripts/**/*.js.map
packages/engine/scripts/**/*.d.ts
packages/engine/scripts/**/*.d.ts.map
apps/cli/src/**/*.js
apps/cli/src/**/*.js.map
apps/cli/src/**/*.d.ts
apps/cli/src/**/*.d.ts.map
apps/web/*.js
apps/web/*.js.map
apps/web/*.d.ts
apps/web/*.d.ts.map
evals/**/*.js
evals/**/*.js.map
evals/**/*.d.ts
evals/**/*.d.ts.map
# Same stale tsc-emit artifacts in the tools/ and scripts/ TS-source
# trees, plus the root vitest config. These dirs are TS-source with
# noEmit:true, so none of these should ever be tracked. (embed.mjs in
# tools/course-catalog-embed is a real .mjs source — *.js won't match it.)
tools/**/*.js
tools/**/*.js.map
tools/**/*.d.ts
tools/**/*.d.ts.map
scripts/**/*.js
scripts/**/*.js.map
scripts/**/*.d.ts
scripts/**/*.d.ts.map
/vitest.config.js
/vitest.config.js.map
/vitest.config.d.ts
/vitest.config.d.ts.map
tsconfig.tsbuildinfo

# Python bytecode cache (e.g. tools/bulletin-scraper)
__pycache__/
*.pyc

# Claude Code local tooling / session state
.claude/

# apps/web/.env.local is a copy of the repo-root .env.local for
# Next.js (which loads from its own cwd, not the monorepo root).
# Both are gitignored via the global *.local pattern at the top.
